<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_country_city_list" model="ir.ui.view">
        <field name="name">res.country.city.list</field>
        <field name="model">res.country.city</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="country_id"/>
                <field name="mmd_id" groups="akdigital_mmd_integration.akdigital_mmd_integration_admin"/>
            </list>
        </field>
    </record>
    <record id="res_country_city_action" model="ir.actions.act_window">
        <field name="name">Ciudades</field>
        <field name="res_model">res.country.city</field>
        <field name="view_mode">list</field>
    </record>
    <menuitem
            id="res_country_city_menu"
            name="Ciudades"
            action="res_country_city_action"
            parent="contacts.menu_localisation"
            sequence="3"
    />

</odoo>